# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local)
# If no MongoDB is connected, the server gracefully provides in-memory fallback for offline/demo tests
MONGODB_URI=mongodb://127.0.0.1:27017/legalmetrix

# Authentication
JWT_SECRET=legalmetrix_sih_super_secure_jwt_secret_key_2024_packaged_compliance
JWT_EXPIRES_IN=7d

# OCR & AI Extraction Providers (Configurable abstraction)
# Options: mock, tesseract, paddle, cloud
OCR_PROVIDER=mock
OCR_API_KEY=your_ocr_provider_api_key_here

# AI Vision & Extraction Model Keys (Optional server-side keys)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
VISION_AI_ENABLED=false
